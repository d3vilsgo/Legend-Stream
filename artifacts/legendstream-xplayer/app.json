{
  "expo": {
    "name": "LegendStream XPlayer",
    "slug": "legendstream-xplayer",
    "version": "1.4.23",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "legendstream-xplayer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07101f"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.legendstream.xplayer",
      "versionCode": 37,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "usesCleartextTraffic": true,
            "useLegacyPackaging": true,
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            }
          }
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "./plugins/withLegendStreamPip",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
